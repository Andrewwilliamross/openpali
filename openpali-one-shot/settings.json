{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "30000",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "100000"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./.claude",
        "./openpali-one-shot/GOAL_PROMPT.txt",
        "./openpali-one-shot/SYSTEM.md",
        "./openpali-one-shot/MISSION.md",
        "./openpali-one-shot/BASELINE.md",
        "./openpali-one-shot/settings.json",
        "./openpali-one-shot/mcp.json",
        "./openpali-one-shot/contract",
        "./openpali-one-shot/plugin",
        "./openpali-one-shot/scripts",
        "./openpali-one-shot/state/evaluator-latest.md",
        "./openpali-one-shot/state/evaluator-attestation.json",
        "./openpali-one-shot/state/evaluator"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.config/gh",
        "~/.kube",
        "~/.docker",
        "~/.netrc",
        "~/.git-credentials",
        "~/.npmrc",
        "~/.pypirc",
        "~/Library/Keychains",
        "./.env",
        "./.env.*",
        "./**/.env",
        "./**/.env.*"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "code.claude.com",
        "platform.claude.com",
        "www.anthropic.com",
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "cdn.playwright.dev",
        "playwright.azureedge.net",
        "playwright-akamai.azureedge.net",
        "playwright-verizon.azureedge.net",
        "pypi.org",
        "files.pythonhosted.org",
        "arxiv.org",
        "www.nist.gov",
        "www.itl.nist.gov",
        "services.arcgis.com",
        "services1.arcgis.com",
        "services5.arcgis.com",
        "tiles.arcgis.com",
        "maps.lacity.org",
        "data.lacity.org",
        "recovery.lacity.gov",
        "recovery.lacounty.gov",
        "planning.lacounty.gov",
        "egis-lacounty.hub.arcgis.com",
        "egis7.gis.lacounty.gov",
        "arcgis.gis.lacounty.gov",
        "www.arcgis.com",
        "www.fire.ca.gov",
        "www.usgs.gov",
        "storms.ngs.noaa.gov",
        "www.fisheries.noaa.gov",
        "www.esri.com",
        "wayback.maptiles.arcgis.com",
        "tiles.openfreemap.org",
        "s3.amazonaws.com",
        "svc.pictometry.com",
        "maliburebuilds.org",
        "mlb-pptsrv.ci.malibu.ca.us",
        "www.insurance.ca.gov",
        "www.fema.gov",
        "web.data.sba.gov",
        "publichealth.lacounty.gov",
        "storymaps.arcgis.com",
        "www.faa.gov",
        "www.esa.int",
        "docs.planet.com",
        "onlinelibrary.wiley.com",
        "pubmed.ncbi.nlm.nih.gov",
        "scikit-survival.readthedocs.io",
        "doi.org",
        "docs.ogc.org",
        "www.khronos.org",
        "www.jmlr.org",
        "localhost",
        "127.0.0.1",
        "docs.prefect.io",
        "mlflow.org",
        "docs.github.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Agent",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:www.nist.gov)",
      "WebFetch(domain:www.itl.nist.gov)",
      "WebFetch(domain:services.arcgis.com)",
      "WebFetch(domain:services1.arcgis.com)",
      "WebFetch(domain:services5.arcgis.com)",
      "WebFetch(domain:tiles.arcgis.com)",
      "WebFetch(domain:maps.lacity.org)",
      "WebFetch(domain:data.lacity.org)",
      "WebFetch(domain:recovery.lacity.gov)",
      "WebFetch(domain:recovery.lacounty.gov)",
      "WebFetch(domain:planning.lacounty.gov)",
      "WebFetch(domain:egis-lacounty.hub.arcgis.com)",
      "WebFetch(domain:egis7.gis.lacounty.gov)",
      "WebFetch(domain:arcgis.gis.lacounty.gov)",
      "WebFetch(domain:www.arcgis.com)",
      "WebFetch(domain:www.fire.ca.gov)",
      "WebFetch(domain:www.usgs.gov)",
      "WebFetch(domain:storms.ngs.noaa.gov)",
      "WebFetch(domain:www.fisheries.noaa.gov)",
      "WebFetch(domain:www.esri.com)",
      "WebFetch(domain:maliburebuilds.org)",
      "WebFetch(domain:mlb-pptsrv.ci.malibu.ca.us)",
      "WebFetch(domain:www.insurance.ca.gov)",
      "WebFetch(domain:www.fema.gov)",
      "WebFetch(domain:web.data.sba.gov)",
      "WebFetch(domain:publichealth.lacounty.gov)",
      "WebFetch(domain:storymaps.arcgis.com)",
      "WebFetch(domain:www.faa.gov)",
      "WebFetch(domain:onlinelibrary.wiley.com)",
      "WebFetch(domain:pubmed.ncbi.nlm.nih.gov)",
      "WebFetch(domain:scikit-survival.readthedocs.io)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:docs.ogc.org)",
      "WebFetch(domain:www.khronos.org)",
      "WebFetch(domain:www.jmlr.org)",
      "WebFetch(domain:docs.prefect.io)",
      "WebFetch(domain:mlflow.org)",
      "WebFetch(domain:docs.github.com)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/Library/Keychains/**)",
      "Edit(/openpali-one-shot/GOAL_PROMPT.txt)",
      "Edit(/openpali-one-shot/SYSTEM.md)",
      "Edit(/openpali-one-shot/MISSION.md)",
      "Edit(/openpali-one-shot/BASELINE.md)",
      "Edit(/openpali-one-shot/settings.json)",
      "Edit(/openpali-one-shot/mcp.json)",
      "Edit(/openpali-one-shot/contract/**)",
      "Edit(/openpali-one-shot/plugin/**)",
      "Edit(/openpali-one-shot/scripts/**)",
      "Edit(/openpali-one-shot/state/evaluator-latest.md)",
      "Edit(/openpali-one-shot/state/evaluator-attestation.json)",
      "Edit(/openpali-one-shot/state/evaluator/**)",
      "Edit(/.claude/**)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(http *)",
      "Bash(https *)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(printenv*)",
      "Bash(security find-*)",
      "Bash(npm publish*)",
      "Bash(terraform *)",
      "Bash(pulumi *)",
      "Bash(kubectl *)"
    ]
  }
}

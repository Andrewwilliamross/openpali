{
  "description": "Compact OpenPali mission continuity and destructive-action guardrails",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/inject_context.py"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guardrails.py"]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*openpali-independent-evaluator.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/capture_evaluator.py"]
          }
        ]
      }
    ]
  }
}

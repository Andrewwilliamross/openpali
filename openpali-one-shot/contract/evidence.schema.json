{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpali.org/schemas/one-shot-acceptance-results-v2.json",
  "title": "OpenPali one-shot terminal acceptance evidence",
  "description": "Structural schema. The task-local deterministic Stop gate also enforces contract coverage, artifact hashes, evaluator freshness, Git ancestry, and terminal-state semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "contract_sha256",
    "release_candidate_commit",
    "generated_at",
    "terminal_state",
    "summary",
    "criteria",
    "evidence",
    "external_blockers",
    "stall_cycles"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "contract_version": {"const": "1.0.0"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "release_candidate_commit": {"$ref": "#/$defs/gitCommit"},
    "generated_at": {"type": "string", "format": "date-time"},
    "terminal_state": {
      "enum": ["IN_PROGRESS", "PASS", "BLOCKED_EXTERNAL", "BUDGET_EXHAUSTED", "STALLED"]
    },
    "summary": {"type": "string", "minLength": 20},
    "criteria": {
      "type": "array",
      "minItems": 19,
      "items": {"$ref": "#/$defs/criterionResult"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "external_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalBlocker"}
    },
    "stall_cycles": {
      "type": "array",
      "items": {"$ref": "#/$defs/stallCycle"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_state": {"const": "PASS"}}},
      "then": {
        "properties": {
          "external_blockers": {"maxItems": 0},
          "stall_cycles": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"terminal_state": {"const": "BLOCKED_EXTERNAL"}}},
      "then": {
        "properties": {
          "external_blockers": {"minItems": 1},
          "stall_cycles": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"terminal_state": {"const": "STALLED"}}},
      "then": {"properties": {"stall_cycles": {"minItems": 3}}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "BASE-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "TRUTH-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "TRUTH-002"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "TRUTH-003"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "DATA-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "DATA-002"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "DATA-003"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "PUB-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "METRIC-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "MODEL-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "MODEL-002"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "PRODUCT-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "PRODUCT-002"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "WEB-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "SPATIAL-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "SPATIAL-002"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "OPS-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "GOV-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    },
    {
      "properties": {"criteria": {"contains": {"properties": {"id": {"const": "RELEASE-001"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "observed_at", "commit", "result", "artifact", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/evidenceId"},
        "kind": {
          "enum": ["command", "report", "browser", "source", "decision", "review"]
        },
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "observed_at": {"type": "string", "format": "date-time"},
        "commit": {"$ref": "#/$defs/gitCommit"},
        "result": {"type": "string", "minLength": 3},
        "artifact": {
          "type": "string",
          "pattern": "^openpali-one-shot/state/(?:evidence/[A-Za-z0-9][A-Za-z0-9._/-]*|evaluator/evaluator-[A-Za-z0-9_-]+(?:\\.attestation)?\\.(?:md|json))$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {"required": ["command", "exit_code"]}
        }
      ]
    },
    "proofResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "status", "evidence_ids"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        }
      }
    },
    "failIfResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "triggered", "evidence_ids"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "triggered": {"type": "boolean"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        }
      }
    },
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "proof_results", "fail_if_results"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "notes": {"type": "string"},
        "proof_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/proofResult"}
        },
        "fail_if_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/failIfResult"}
        }
      }
    },
    "externalBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_ids",
        "category",
        "decision_owner",
        "decision_needed",
        "safe_default",
        "evidence_ids",
        "resume_command"
      ],
      "properties": {
        "criterion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "category": {
          "enum": [
            "license_or_right",
            "credential",
            "private_input",
            "material_spend",
            "destructive_action",
            "scope_decision"
          ]
        },
        "decision_owner": {"type": "string", "minLength": 2},
        "decision_needed": {"type": "string", "minLength": 10},
        "safe_default": {"type": "string", "minLength": 10},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "resume_command": {"type": "string", "minLength": 3}
      }
    },
    "stallCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "commit",
        "started_at",
        "ended_at",
        "repair_or_replan",
        "observed_result",
        "evidence_ids"
      ],
      "properties": {
        "cycle": {"type": "integer", "minimum": 1},
        "commit": {"$ref": "#/$defs/gitCommit"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "repair_or_replan": {"type": "string", "minLength": 10},
        "observed_result": {"type": "string", "minLength": 10},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        }
      }
    }
  }
}
